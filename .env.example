# Replace these values to use a different tile provider without changing the UI.
# Site generation: Gemini BYOK from Settings or a server-only key.
# GEMINI_API_KEY=
# Production server credentials require this access token (advanced connection UI).
# SITE_AI_ACCESS_TOKEN=
# Optional existing local provider, configured by the server administrator only.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# SITE_AI_DISABLED_MODELS=gemini:model-id,ollama:model-id
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Media Pipeline (Phase C.1 Licensed Media)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
MEDIA_MAX_ASSET_BYTES=5242880
MEDIA_PROVIDER_TIMEOUT_MS=5000

